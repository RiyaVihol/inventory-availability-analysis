      <aliases enabled='yes' />
      <column caption='Actual Stock' datatype='integer' name='[Actual_Stock]' role='measure' type='quantitative' />
      <column caption='Availability Status' datatype='string' name='[Availability_Status]' role='dimension' type='nominal' />
      <column caption='Inventory Discrepancy' datatype='integer' name='[Calculation_0086624415612928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([System_Stock])- SUM([Actual_Stock])' />
      </column>
      <column caption='Fixed' datatype='integer' name='[Calculation_0087106158977025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed [Product_Name]: SUM([Quantity_Ordered])}' />
      </column>
      <column caption='Include product qty' datatype='integer' name='[Calculation_0087106163613698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Product_Name]:SUM([Quantity_Ordered]) }' />
      </column>
      <column aggregation='Attribute' caption='Exclude' datatype='real' name='[Calculation_0087106170105859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Product_Name] : AVG([Quantity_Ordered]) }' />
      </column>
      <column caption='qty threashold' datatype='boolean' name='[Calculation_0087106179289093]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Quantity_Ordered]) &gt;= [Parameters].[Parameter 0087106178596868]' />
      </column>
      <column caption='False Availability' datatype='integer' name='[Calculation_0090267964817408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Availability_Status] = &quot;Available&quot;&#10;AND [Actual_Stock] &lt;=0&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Cancellation Reason' datatype='string' name='[Cancellation_Reason]' role='dimension' type='nominal' />
